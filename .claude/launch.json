{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "widget-test",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dev/widget"
      ],
      "port": 8765
    },
    {
      "name": "shiny-test",
      "runtimeExecutable": "Rscript",
      "runtimeArgs": [
        "-e",
        "devtools::load_all('.', quiet = TRUE); shiny::runApp('dev/shiny-test', port = 8766, launch.browser = FALSE)"
      ],
      "port": 8766
    },
    {
      "name": "sketch-studio",
      "runtimeExecutable": "Rscript",
      "runtimeArgs": [
        "-e",
        "devtools::load_all('.', quiet = TRUE); shiny::runApp(run_sketch_studio(launch.browser = FALSE), port = 8767, launch.browser = FALSE)"
      ],
      "port": 8767
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8769",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 8769
    },
    {
      "name": "denr",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd ../../makeit/pocket-r && POCKET_R_PORT=4191 node scripts/serve.mjs"],
      "port": 4191
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8770", "--bind", "127.0.0.1", "--directory", "site-dist"],
      "port": 8770
    }
  ]
}