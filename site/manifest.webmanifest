{
  "name": "excalidrawer",
  "short_name": "excalidrawer",
  "description": "Hand-drawn diagrams and charts: Excalidraw with stickers, people, style presets, Mermaid, animated SVGs and Obsidian files. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fdfcf7",
  "theme_color": "#fdfcf7",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.excalidraw+json": [".excalidraw"],
        "text/markdown": [".md"]
      }
    }
  ]
}
