Package: scratchy
Title: Hand-Drawn Charts, Drawings and Slides in the 'Excalidraw' Style
Version: 0.1.0
Authors@R: c(
    person("Joseph S.", "Miller", , "jossammil@gmail.com", role = c("aut", "cre")),
    person("Excalidraw", role = c("ctb", "cph"),
           comment = "Excalidraw editor, shape logic ported in inst/js/exc-shapes.js, Excalifont, sticker libraries"),
